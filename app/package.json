    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
